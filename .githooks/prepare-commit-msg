#!/usr/bin/env bash
# prepare-commit-msg
#
# One interactive prompt on `git commit`: the commit type prefix
# (feat/fix/chore/...), prepended to the subject. Skipped if the message
# already starts with a Conventional Commits prefix (so re-edits and
# tool-generated commits like bump-my-version are not double-prefixed), and
# for merge/squash/amend commits and `git commit -m "..."`.
#
# There is no `Assisted-by:` prompt any more. It dates from when AI tools
# handed a human the diff to commit; an agent now commits on its own and
# writes its own trailer into the message, so the prompt only ever asked a
# question nobody at the terminal could answer better than the message did.
#
# Install: cp prepare-commit-msg .git/hooks/prepare-commit-msg
#          chmod +x .git/hooks/prepare-commit-msg
#
# To share with your team, commit this file to .githooks/ and set:
#   git config core.hooksPath .githooks
# (otto-sh's `make dev` does this for you.)

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Skip automated commit sources (merges, squashes, amends, -m flag)
case "$COMMIT_SOURCE" in
    merge|squash|commit)
        exit 0
        ;;
esac

# ── Commit type prompt ────────────────────────────────────────────────────────
# Conventional Commits prefixes. Keep in sync with the table in
# docs/contributing.md > "Branching and commits".
TYPE_OPTIONS=(feat fix chore docs test refactor ci)
TYPE_LABELS=(
    "New feature"
    "Bug fix"
    "No production code change (tooling, deps, refactors)"
    "Documentation only"
    "Tests only"
    "Code restructuring, no behavior change"
    "CI/CD configuration"
)
TYPE_SKIP=$((${#TYPE_OPTIONS[@]} + 1))
# Default to NO prefix. `chore` used to be the default on the theory that it was
# the safest guess, but a guessed prefix is worse than none: it is wrong more
# often than not, and it silently mangles a subject that already says what it
# is. Empty input now leaves the message exactly as written.
TYPE_DEFAULT=$TYPE_SKIP

# First non-comment line of the existing message — used to detect a
# pre-existing conventional prefix and skip the prompt in that case.
first_line=$(grep -m1 -v '^#' "$COMMIT_MSG_FILE" | head -n1)

# Regex must live in a variable so bash's `[[ =~ ]]` parses the parens as
# regex syntax rather than shell grouping. Reference unquoted below.
conventional_prefix_re='^(feat|fix|chore|docs|test|refactor|ci|build|perf|style|revert)(\([^)]+\))?!?:'

# The tty probe is a plain command rather than `exec`, so it fails cleanly into
# "skip the prompt" instead of printing `/dev/tty: No such device or address`
# and then reading EOF. Without it, a scripted commit fell through to whatever
# TYPE_DEFAULT was and got that prefix prepended to a subject that never asked
# for one.
if [[ ! "$first_line" =~ $conventional_prefix_re ]] && { : < /dev/tty; } 2>/dev/null; then
    # Read from terminal directly — stdin is not available in git hooks
    exec < /dev/tty

    echo ""
    echo "Commit type (Conventional Commits):"
    for i in "${!TYPE_OPTIONS[@]}"; do
        num=$((i + 1))
        marker=""
        [ "$num" -eq "$TYPE_DEFAULT" ] && marker="  (default)"
        printf "  [%s] %-10s %s%s\n" "$num" "${TYPE_OPTIONS[$i]}:" "${TYPE_LABELS[$i]}" "$marker"
    done
    skip_marker=""
    [ "$TYPE_SKIP" -eq "$TYPE_DEFAULT" ] && skip_marker="  (default)"
    printf "  [%s] %-10s leave message as-is%s\n" "$TYPE_SKIP" "skip:" "$skip_marker"
    printf "Select [%s]: " "$TYPE_DEFAULT"
    read -r tchoice

    # Resolve empty input to the default
    [ -z "$tchoice" ] && tchoice="$TYPE_DEFAULT"

    if [[ "$tchoice" =~ ^[0-9]+$ ]] \
       && [ "$tchoice" -ge 1 ] \
       && [ "$tchoice" -le "${#TYPE_OPTIONS[@]}" ]; then
        prefix="${TYPE_OPTIONS[$((tchoice - 1))]}: "
        # Prepend without trailing newline — first line becomes "<prefix> "
        # followed by whatever was on the original first line (typically blank).
        tmp=$(mktemp)
        printf '%s' "$prefix" > "$tmp"
        cat "$COMMIT_MSG_FILE" >> "$tmp"
        mv "$tmp" "$COMMIT_MSG_FILE"
    fi
    # Skip option or invalid input → leave the message untouched.

    exec < /dev/null
fi

exit 0
