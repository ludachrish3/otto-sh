#!/usr/bin/env bash
# commit-msg
#
# Runs commitlint (web/node_modules) over the commit message with the repo-root
# commitlint.config.mjs, which enables ONE rule, `breaking-change-exclamation-mark`:
# a `!` before the header's `:` and a `BREAKING CHANGE:` footer go together, or
# neither is present. Merge commits and `fixup!`/`squash!` subjects pass.
#
# Backstop: `make check-breaking` in the pre-push hook and CI's `lint-python` is
# the authority and checks far more (docs/contributing.md, the breaking-change
# section); this hook only catches the mismatch while the message is still fresh.
#
# Escape hatch: `git commit --no-verify`.
#
# Installed by `make dev` via: git config core.hooksPath .githooks
set -euo pipefail

# Locate everything relative to this script, so the hook works in the checkout
# and in a scratch repo that points core.hooksPath here.
root="$(cd "$(dirname "$0")/.." && pwd)"
bin="$root/web/node_modules/.bin/commitlint"

# Fail closed but explain why, as pre-push does for a missing uv.
if [ ! -x "$bin" ] || ! command -v node >/dev/null 2>&1; then
    echo "commit-msg: commitlint or node not found (web/node_modules/.bin, PATH) — run 'make web-install' and put node on PATH." >&2
    echo "commit-msg: or bypass this hook with: git commit --no-verify" >&2
    exit 1
fi

exec "$bin" --config "$root/commitlint.config.mjs" --edit "$1"
