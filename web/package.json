{
  "name": "otto-monitor-web",
  "private": true,
  "version": "0.1.0",
  "description": "React+TS frontend for the otto monitor dashboard, built to src/otto/_webassets/monitor/dist/.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "../scripts/typecheck_web.sh && vite build",
    "build:covapp": "vite build --config vite.covapp.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "knip": "knip",
    "e2e:coverage-report": "node scripts/e2e_coverage_report.mjs",
    "coverage:merged": "nyc report --temp-dir ../reports/ts-cov/final --report-dir ../reports/ts-cov/html --reporter text --reporter html --check-coverage --statements 91 --branches 78 --functions 94 --lines 95 && nyc check-coverage --temp-dir ../reports/ts-cov/final --per-file --statements 1 --branches 1 --functions 1 --lines 1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@react-stately/utils": "3.12.1",
    "@tailwindcss/vite": "4.3.3",
    "@untitledui/file-icons": "0.0.9",
    "@untitledui/icons": "0.0.22",
    "@xyflow/react": "12.11.6",
    "echarts": "6.1.0",
    "input-otp": "1.5.0",
    "react": "19.2.8",
    "react-aria": "3.52.0",
    "react-aria-components": "1.21.0",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-react-aria-components": "2.2.0",
    "wouter": "3.10.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@biomejs/biome": "2.5.11",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "knip": "6.32.2",
    "monocart-coverage-reports": "2.13.0",
    "nyc": "18.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
