# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
# ...except this one, which is FIXTURE INPUT rather than build output: a
# committed wheel a test installs offline. Without this negation the whole
# directory is invisible to git and the suite passes locally while CI has
# no wheel to install.
!tests/_fixtures/wheels/
*.egg-info

# Virtual environments
.venv

# Dummy files
tests/repo1/product/product

# Test artifacts (coverage data + HTML, JUnit XML)
reports/
*.gcno
*.gcda
# ...but keep the committed golden fixtures the embedded-collector unit tests
# decode against (a live mps2_an385 cov_dump capture + its known-good .gcda).
!tests/unit/fixtures/embedded_coverage/*.gcda
!tests/unit/fixtures/embedded_coverage/*.gcno

# otto CLI per-subcommand output dirs — timestamped run artifacts written at
# the repo root by `otto test|host|cov|run|monitor|docker`. Root-anchored so
# they never shadow tests/ or src/otto/.
/test/
/host/
/cov/
/run/
/monitor/
/docker/

# Performance files
profile.txt

# Sphinx build output
docs/_build

# Build-time GUI media (scripts/capture_docs_media.py) — never committed
docs/_static/generated/
# Rendered from schemas/support_matrix.json by scripts/render_support_matrix.py on
# every Sphinx build (docs/conf.py, builder-inited). Committing it would put a second
# copy of all 54 verdicts in the tree, and the copy that goes stale is the one nothing
# runs.
docs/architecture/support-matrix.md

# Rendered from schemas/kgcov_matrix.json by scripts/render_kgcov_matrix.py on every
# Sphinx build (docs/conf.py, builder-inited); the committed copy would be the stale one.
docs/cli/cov/instrumenting/kgcov-matrix.md

# Claude files
.claude

# Superpowers SDD scratch (task briefs, reports, diffs, progress ledger)
.superpowers/

# Generated JSON Schema (otto schema export default output), EXCEPT the two
# support-matrix files, which spec 2026-08-22 §4/§5 name at this path and which
# a person commits. `/schemas/*` rather than `/schemas/`: git never descends
# into an excluded DIRECTORY, so a re-include under one is inert -- measured
# both spellings in a throwaway repo, and only the glob lets the `!` lines bite.
/schemas/*
!/schemas/support-matrix.schema.json
!/schemas/support_matrix.json
!/schemas/kgcov-matrix.schema.json
!/schemas/kgcov_matrix.json

# web/ (React+TS monitor dashboard + covapp coverage SPA) build output +
# deps — regenerated by `make web-install` / `make web`; see Makefile web-*
# targets. One glob for both in-package build artifacts registered in
# src/otto/_webassets/ (otto._webassets.ALL) — it keeps __init__.py tracked
# (the glob only matches directories under _webassets/, not the module file
# itself) while ignoring each artifact's built contents (monitor/dist/,
# covapp/).
src/otto/_webassets/*/
web/node_modules/
# vitest v8 coverage output (text + HTML), from `make coverage-ts-unit`.
web/coverage/

# SDD execution plans — untracked going forward, purged 2026-08-03: at ~120k
# lines (2.3x the Python source tree) they were the repo-bloat driver and
# grep pollution. The full set is one checkout away: git tag
# plans-archive-2026-08-03. Specs (decision records) stay tracked — they are
# cited from src/ docstrings and todos.
docs/superpowers/plans/

# NB: no BusyBox entry here on purpose. The fetched artifacts live in
# ~/.cache/otto/busybox (or wherever OTTO_BUSYBOX_CACHE points), never inside
# the repo, so an ignore rule for them would match nothing and read as though
# the tree could contain them.

# kernel build products of the repo5 fixture
tests/repo5/build/

# repo5's vendored copy of the library (tests/repo5/third_party/otto_kgcov/)
# is committed source, exported by `otto cov kgcov export`. The package copy
# at src/otto/kgcov/ is never built in place — its build.sh builds out of
# tree — so it carries no ignore patterns of its own: a git-ignored file
# under src/otto/ would ship silently in the uv_build sdist/wheel, and
# tests/unit/test_webassets_guard.py's in-package-ignores guard holds
# src/otto/ to exactly the webassets glob for that reason. A hand build in
# place under this vendored copy (mirroring the library's own out-of-tree
# build.sh) must not commit objects either, so the same ten patterns apply
# here, and tests/unit/test_kgcov_export.py's package-hygiene guard fails on
# any stray file left behind by one.
tests/repo5/third_party/otto_kgcov/**/*.o
tests/repo5/third_party/otto_kgcov/**/*.ko
tests/repo5/third_party/otto_kgcov/**/*.mod
tests/repo5/third_party/otto_kgcov/**/*.mod.c
tests/repo5/third_party/otto_kgcov/**/*.cmd
tests/repo5/third_party/otto_kgcov/**/.*.cmd
tests/repo5/third_party/otto_kgcov/**/.*.o.d
tests/repo5/third_party/otto_kgcov/**/Module.symvers
tests/repo5/third_party/otto_kgcov/**/modules.order
tests/repo5/third_party/otto_kgcov/**/*.gcno

# repo5's own demo product builds in place (tests/repo5/kmod/demo/) rather
# than out of tree, so its build products need their own per-extension
# list (mirroring tests/repo5/third_party/otto_kgcov/**'s shape above),
# scoped to that directory instead of a blanket build/ (the demo's sources
# live right beside these outputs).
tests/repo5/kmod/**/*.o
tests/repo5/kmod/**/*.ko
tests/repo5/kmod/**/*.mod
tests/repo5/kmod/**/*.mod.c
tests/repo5/kmod/**/*.cmd
tests/repo5/kmod/**/.*.o.d
tests/repo5/kmod/**/Module.symvers
tests/repo5/kmod/**/modules.order
tests/repo5/kmod/**/*.gcno
tests/repo5/kmod/**/*.gcda
tests/repo5/kmod/**/.tmp_versions
tests/repo5/kmod/**/*.a
tests/repo5/kmod/**/*.symvers

# repo5's container-image product builds in place too (tests/repo5/docker/):
# the compiled binary and its .gcno files stay out of tree in docker/build/
# (its committed sources sit right beside it, under docker/src/), and the
# saved image tarball is a build product of docker/build.sh, not a fixture
# input.
tests/repo5/docker/build/
tests/repo5/docker/*.tar
