# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Dummy files
tests/repo1/product/product

# Test artifacts (coverage data + HTML, JUnit XML)
reports/
*.gcno
*.gcda
# ...but keep the committed golden fixtures the embedded-collector unit tests
# decode against (a live mps2_an385 cov_dump capture + its known-good .gcda).
!tests/unit/fixtures/embedded_coverage/*.gcda
!tests/unit/fixtures/embedded_coverage/*.gcno

# otto CLI per-subcommand output dirs — timestamped run artifacts written at
# the repo root by `otto test|host|cov|run|monitor|docker`. Root-anchored so
# they never shadow tests/ or src/otto/.
/test/
/host/
/cov/
/run/
/monitor/
/docker/

# Performance files
profile.txt

# Sphinx build output
docs/_build

# Build-time GUI media (scripts/capture_docs_media.py) — never committed
docs/_static/generated/

# Claude files
.claude

# Superpowers SDD scratch (task briefs, reports, diffs, progress ledger)
.superpowers/

# Generated JSON Schema (otto schema export default output)
/schemas/

# web/ (React+TS monitor dashboard + covapp coverage SPA) build output +
# deps — regenerated by `make web-install` / `make web`; see Makefile web-*
# targets. One glob for both in-package build artifacts registered in
# src/otto/_webassets/ (otto._webassets.ALL) — it keeps __init__.py tracked
# (the glob only matches directories under _webassets/, not the module file
# itself) while ignoring each artifact's built contents (monitor/dist/,
# covapp/).
src/otto/_webassets/*/
web/node_modules/
# vitest v8 coverage output (text + HTML), from `make coverage-ts-unit`.
web/coverage/

# SDD process artifacts — untracked going forward (2026-08-03): docs/superpowers
# had grown to ~143k lines (>4x the published docs) and inflated every churn
# metric and diff review. Already-tracked files under it keep working normally
# until a decided sweep; git history retains everything regardless.
docs/superpowers/
